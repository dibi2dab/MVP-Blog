# ===============================================================================
# 환경 변수 예시. 이 파일을 .env 로 복사해서 사용한다.
# 절대 실제 키 값을 커밋하지 않는다.
# ===============================================================================

# --- 실행 모드 ---------------------------------------------------------------
# MOCK_MODE=true 로 두면 외부 API 없이도 전체 파이프라인을 시뮬레이션할 수 있다.
MOCK_MODE=auto

# --- AI Provider -------------------------------------------------------------
# auto | openai | anthropic | google | mock
AI_PROVIDER=auto
# AI_PROVIDER=mock

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514

GOOGLE_API_KEY=
GOOGLE_MODEL=gemini-2.0-flash
GOOGLE_PROJECT_ID=

# --- 주식 데이터 -------------------------------------------------------------
# 네이버 공개 차트 API는 키가 필요 없다. mock 으로 강제할 때만 사용.
STOCK_PROVIDER=naver

# --- DART 공시 ---------------------------------------------------------------
# https://opendart.fss.or.kr 에서 API 키 발급
DART_API_KEY=

# --- 뉴스 ---------------------------------------------------------------------
# google_rss | mock
NEWS_PROVIDER=google_rss

# --- 게시 ---------------------------------------------------------------------
# local | mock | tistory-node | tistory
PUBLISH_BACKEND=tistory-node
# PUBLISH_BACKEND=tistory      # Python Playwright fallback publisher
# PUBLISH_BACKEND=local

# --- 티스토리 (Playwright 세션 자동 발행) -------------------------------------
# 티스토리 공식 Open API / Access Token 은 사용하지 않는다.
# Tistory Open API가 종료되어 브라우저 자동화(Playwright) + 저장된 로그인 세션 방식 사용.

# 블로그 주소 (예: https://myblog.tistory.com)
TISTORY_BLOG_URL=

# 로그인 세션 파일 위치 (scripts/tistory_login.py 로 생성)
TISTORY_STORAGE_STATE_PATH=.state/tistory_storage_state.json
# GitHub Actions 에서는 아래 Secret 을 사용한다 (storage_state 를 Base64 인코딩한 값)
# TISTORY_STORAGE_STATE=<base64>

# 실제 발행 없이 에디터 진입/입력만 테스트 (true/false)
TISTORY_DRY_RUN=false
# 기본 공개 설정: private | protected | public
TISTORY_VISIBILITY=private
# 헤드리스 브라우저 여부 (로컬 디버깅 시 false)
TISTORY_HEADLESS=true

# Continue publishing when some chart images fail to upload (default: false)
TISTORY_ALLOW_MISSING_IMAGES=false

# --- Kakao auto-login (optional) ---------------------------------------------
# Tistory's TSID cookie expires in ~30 minutes. If set, the publisher logs in
# automatically before publishing. Keep these in GitHub Secrets, never commit.
TISTORY_KAKAO_ID=
TISTORY_KAKAO_PASSWORD=

# --- 디버깅 ------------------------------------------------------------------
LOG_LEVEL=INFO